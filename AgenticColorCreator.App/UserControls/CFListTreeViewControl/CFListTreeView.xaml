<UserControl x:Class="AgenticColorCreator.App.UserControls.CFListTreeViewControl.CFListTreeView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:AgenticColorCreator.App.UserControls.CFListTreeViewControl">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="..\..\CFStyles\CFDarkStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<DataTemplate x:Key="CFListTreeViewRowTemplate" DataType="{x:Type local:CFListTreeViewRow}">
				<Grid Margin="{Binding Indent}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="18" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<ToggleButton x:Name="Expander"
							  Width="16"
							  Height="16"
							  Background="{StaticResource CF.TreeView.Default.GlyphBackground}"
							  BorderBrush="{StaticResource CF.TreeView.Default.GlyphBorder}"
							  BorderThickness="1"
							  Focusable="False"
							  IsChecked="{Binding IsExpanded, Mode=OneWay}"
							  Click="OnExpanderClick"
							  Template="{StaticResource CF.TreeViewExpanderToggleTemplate}">
						<Path x:Name="ExpanderGlyph"
							  Width="8"
							  Height="8"
							  Data="M 0 0 L 4 4 L 0 8 Z"
							  Fill="{StaticResource CF.TreeView.Default.Glyph}"
							  Stretch="Uniform" />
					</ToggleButton>
					<Grid Grid.Column="1">
						<StackPanel Orientation="Horizontal">
							<Image Width="14" Height="14" Stretch="Uniform">
								<Image.Style>
									<Style TargetType="Image">
										<Setter Property="Source" Value="{Binding DefaultIcon}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
												<Setter Property="Source" Value="{Binding MouseOverIcon}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding IsSelected}" Value="True">
												<Setter Property="Source" Value="{Binding SelectedIcon}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Image.Style>
							</Image>
							<TextBlock x:Name="FolderName" Margin="6,0,0,0"
									   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
									   Text="{Binding Name}" />
							<ContentControl x:Name="LeafContent"
									Margin="6,0,0,0"
									Visibility="Collapsed"
									Content="{Binding Item}"
									ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=local:CFListTreeView}}" />
							<StackPanel x:Name="ResourceTypeContent"
										Margin="4,0,0,0"
										Orientation="Horizontal"
										Visibility="Collapsed">
								<TextBlock x:Name="ResourceTypeDot" Foreground="{StaticResource CF.Text.Disabled.Foreground}" Text="." />
								<TextBlock x:Name="ResourceTypeText" Foreground="{StaticResource CF.Text.Disabled.Foreground}" Text="{Binding ResourceType}" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</Grid>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding IsFolder}" Value="False">
						<Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
						<Setter TargetName="FolderName" Property="Visibility" Value="Collapsed" />
						<Setter TargetName="LeafContent" Property="Visibility" Value="Visible" />
					</DataTrigger>
					<DataTrigger Binding="{Binding HasChildren}" Value="False">
						<Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
					</DataTrigger>
					<DataTrigger Binding="{Binding IsExpanded}" Value="True">
						<Setter TargetName="ExpanderGlyph" Property="LayoutTransform">
							<Setter.Value>
								<RotateTransform Angle="90" />
							</Setter.Value>
						</Setter>
					</DataTrigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions>
							<Condition Binding="{Binding IsFolder}" Value="False" />
							<Condition Binding="{Binding ShowResourceType, RelativeSource={RelativeSource AncestorType={x:Type local:CFListTreeView}}}" Value="True" />
						</MultiDataTrigger.Conditions>
						<Setter TargetName="ResourceTypeContent" Property="Visibility" Value="Visible" />
					</MultiDataTrigger>
					<DataTrigger Binding="{Binding IsSelected}" Value="True">
						<Setter TargetName="ResourceTypeDot" Property="Foreground" Value="{StaticResource CF.Text.Default.Foreground}" />
						<Setter TargetName="ResourceTypeText" Property="Foreground" Value="{StaticResource CF.Text.Default.Foreground}" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</UserControl.Resources>
	<ListView x:Name="RowsListView"
			  Style="{StaticResource CF.CFListTreeView}"
			  ItemContainerStyle="{StaticResource CF.CFListTreeViewItem}"
			  ItemTemplate="{StaticResource CFListTreeViewRowTemplate}"
			  PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
			  PreviewKeyDown="OnPreviewKeyDown" />
</UserControl>
