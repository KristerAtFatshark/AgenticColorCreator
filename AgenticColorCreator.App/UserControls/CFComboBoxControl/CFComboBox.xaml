<UserControl x:Class="AgenticColorCreator.App.UserControls.CFComboBoxControl.CFComboBox"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="24"
			 d:DesignWidth="180">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
	</UserControl.Resources>
	<Grid>
		<ComboBox x:Name="InnerComboBox"
				  Style="{StaticResource CF.ComboBox}"
				  Template="{StaticResource CF.ComboBoxTemplate}"
				  ItemContainerStyle="{StaticResource CF.ComboPopupItemStyle}"
				  VerticalContentAlignment="Center"
				  IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsEnabled}"
				  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ItemsSource}"
				  DisplayMemberPath="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DisplayMemberPath}"
				  SelectionChanged="OnInnerSelectionChanged" />

		<Border Background="#80AAAAAA"
				IsHitTestVisible="False"
				Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsMixedState, Converter={StaticResource BooleanToVisibilityConverter}}"
				VerticalAlignment="Stretch"
				HorizontalAlignment="Stretch"
				CornerRadius="4">
			<TextBlock Text="– Mixed –"
					   Foreground="Black"
					   FontWeight="Bold"
					   Opacity="0.8"
					   FontSize="12"
					   HorizontalAlignment="Center"
					   VerticalAlignment="Center"
					   TextWrapping="NoWrap" />
		</Border>
	</Grid>
</UserControl>
